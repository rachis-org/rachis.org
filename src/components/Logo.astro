---
import logo from '~/assets/images/rachis-logo.svg?raw';
---

<span class="rachis-logo" role="img" aria-label="Rachis" set:html={logo} />

<style>
  .rachis-logo {
    display: inline-flex;
    color: var(--aw-color-text-heading);
  }
  .rachis-logo :global(svg) {
    width: 10rem;
    height: 2.5rem;
    fill: currentColor;
  }
  :global(.dark) .rachis-logo :global(g[stroke]) {
    stroke: var(--aw-color-primary);
  }
  @media (max-width: 640px) {
    .rachis-logo :global(svg) {
      width: 9rem;
      height: 2.25rem;
    }
  }
</style>
