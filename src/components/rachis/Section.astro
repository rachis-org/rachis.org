---
interface Props {
  id: string;
  eyebrow?: string;
  tone?: 'plain' | 'soft' | 'dark';
  compact?: boolean;
}
const { id, eyebrow, tone = 'plain', compact = false } = Astro.props;
---

<section id={id} class:list={['rachis-section', `tone-${tone}`, { compact }]} aria-labelledby={`${id}-title`}>
  <div class="section-inner">
    <header class="section-heading">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <div id={`${id}-title`} class="section-title"><slot name="title" /></div>
      {
        Astro.slots.has('intro') && (
          <div class="section-intro">
            <slot name="intro" />
          </div>
        )
      }
    </header>
    <slot />
  </div>
  {
    Astro.slots.has('fullwidth') && (
      <div class="section-fullwidth">
        <slot name="fullwidth" />
      </div>
    )
  }
</section>

<style>
  .rachis-section {
    --section-space: 3rem;
    --section-inset: var(--section-space);
    --section-gutter: 1.5rem;
    --section-content-width: 1160px;
    display: flow-root;
    padding: var(--section-inset) var(--section-gutter);
    /* Account for internal padding so every anchor's heading clears the header. */
    scroll-margin-top: calc(var(--rachis-anchor-offset) - var(--section-inset));
  }
  .tone-plain {
    --section-space: 5rem;
    --section-inset: 0rem;
    /* Adjacent plain sections share one gap rather than adding two paddings. */
    margin-block: var(--section-space);
  }
  .section-inner {
    max-width: var(--section-content-width);
    margin: auto;
  }
  .section-fullwidth {
    margin-inline: calc(-1 * var(--section-gutter));
  }
  .section-heading {
    max-width: 760px;
    margin-bottom: 2rem;
  }
  .section-title :global(h2) {
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    line-height: 1.16;
    font-weight: 650;
    letter-spacing: -0.045em;
    margin: 0.5rem 0 1rem;
  }
  .section-intro {
    color: var(--aw-color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .section-intro :global(p) {
    margin: 0;
  }
  .tone-soft {
    background: var(--rachis-bg-soft);
  }
  .compact {
    --section-space: 2rem;
  }
  .compact .section-heading {
    margin-bottom: 1.5rem;
  }
  .compact .section-title :global(h2) {
    margin-bottom: 0;
  }
  .tone-dark {
    background: #1a414c;
    color: #ffffff;
  }
  .tone-dark .section-intro {
    color: #d5e3e9;
  }
  .tone-dark .eyebrow {
    color: #eb871d;
  }
  @media (max-width: 640px) {
    .rachis-section {
      --section-space: 2rem;
      --section-gutter: 1.25rem;
    }
    .rachis-section.compact {
      --section-space: 1.75rem;
    }
  }
</style>
