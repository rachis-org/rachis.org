---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --tw-prose-links: #2e5e6b;
    --tw-prose-active-links: #eb871d;

    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #2e5e6b;
    --aw-color-secondary: #eb871d;
    --aw-color-accent: #eb871d;

    --aw-color-text-heading: #000000;
    --aw-color-text-default: #101010;
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: #ffffff;

    --aw-color-bg-page-dark: #030620;
    --rachis-bg-soft: #f7f9fb;
    --rachis-bg-card: #ffffff;
    --rachis-border: #dbe3e8;
    --rachis-hero-wash: #ffffff;
    --rachis-on-primary: #ffffff;
    --rachis-primary-hover: #1a414c;

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #0d99ff;
    --aw-color-secondary: #d78023;
    --aw-color-accent: #d78023;

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: #030620;
    --rachis-bg-soft: #0b122a;
    --rachis-bg-card: #101b32;
    --rachis-border: #334155;
    --rachis-hero-wash: #0b122a;
    --rachis-on-primary: #030620;
    --rachis-primary-hover: #087bc9;
    --tw-prose-links: #0d99ff;
    --tw-prose-active-links: #d78023;

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
